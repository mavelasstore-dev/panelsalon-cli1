# ============================================================
# Variables de entorno del backend — Karl Salón
# ============================================================

# Groq (gratis) — https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_key_aqui
# Modelo de Groq (opcional). Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
# Timeout de Groq en ms (opcional). Default: 20000
GROQ_TIMEOUT_MS=20000

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc_tu_service_key_aqui

# Puerto (Railway lo asigna solo)
PORT=3000

# Carpeta de sesión de WhatsApp.
# En Railway: crear un VOLUMEN con mount path /app/auth
# y esta variable puede quedar en /app/auth (es el default)
AUTH_DIR=/app/auth

# Zona horaria del negocio (opcional). Default: America/Bogota
TZ_NEGOCIO=America/Bogota

# ---- Seguridad y handoff (opcionales) ----
# Si lo defines, protege /reset-sesion, /desvincular, /pausar, etc.
# El panel debe mandarlo en el header X-Admin-Token o ?token=
ADMIN_TOKEN=

# Número de la dueña (solo dígitos, con indicativo) para avisos de handoff.
# Ej: 573001234567. Si se deja vacío, no se envían avisos.
NUMERO_DUENO=

# Segundos de espera para agrupar mensajes rápidos (opcional). Default: 3500 ms
DEBOUNCE_MS=3500

# ---- Anti-ban (opcionales; valores por defecto seguros) ----
ANTIBAN_MAX_HORA=25
ANTIBAN_MAX_DIA=200
ANTIBAN_WARMUP_DIAS=7
ANTIBAN_WARMUP_INICIAL=40
ANTIBAN_MIN_DELAY=1600
ANTIBAN_MAX_DELAY=7000
